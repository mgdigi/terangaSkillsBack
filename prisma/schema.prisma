generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  isActive     Boolean       @default(true)
  managerId    String?
  complaints   Complaint[]
  manager      User?         @relation("DepartmentManager", fields: [managerId], references: [id])
  requestTypes RequestType[]
  agents       User[]
}

model RequestType {
  id           String                  @id @default(uuid())
  name         String                  @unique
  description  String?
  departmentId String
  requests     AdministrativeRequest[]
  department   Department              @relation(fields: [departmentId], references: [id])
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String
  firstName               String
  lastName                String
  phone                   String?
  role                    Role                     @default(CITIZEN)
  isActive                Boolean                  @default(true)
  refreshToken            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  departmentId            String?
  address                 String?
  assignedAt              DateTime?
  employeeId              String?                  @unique
  jobTitle                String?
  nationalId              String?                  @unique
  actions                 ActionLog[]
  documentsIssued         AdministrativeDocument[] @relation("AgentDocs")
  documentsReceived       AdministrativeDocument[] @relation("CitizenDocs")
  assignedRequests        AdministrativeRequest[]  @relation("AssignedAgent")
  administrativeRequests  AdministrativeRequest[]  @relation("CitizenRequests")
  complaints              Complaint[]
  managedDepartments      Department[]             @relation("DepartmentManager")
  missingDocumentsReports MissingDocument[]
  department              Department?              @relation(fields: [departmentId], references: [id])
}

model AdministrativeRequest {
  id              String                  @id @default(uuid())
  title           String
  description     String
  status          RequestStatus           @default(SUBMITTED)
  citizenId       String
  assignedAgentId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  attachments     String[]
  data            Json?
  requestTypeId   String
  history         ActionLog[]
  document        AdministrativeDocument?
  assignedAgent   User?                   @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  citizen         User                    @relation("CitizenRequests", fields: [citizenId], references: [id])
  requestType     RequestType             @relation(fields: [requestTypeId], references: [id])
}

model AdministrativeDocument {
  id             String                @id @default(uuid())
  documentNumber String                @unique
  fileUrl        String
  qrCode         String?               @unique
  status         String                @default("VALID")
  citizenId      String
  agentId        String
  requestId      String                @unique
  issuedAt       DateTime              @default(now())
  createdAt      DateTime              @default(now())
  agent          User                  @relation("AgentDocs", fields: [agentId], references: [id])
  citizen        User                  @relation("CitizenDocs", fields: [citizenId], references: [id])
  request        AdministrativeRequest @relation(fields: [requestId], references: [id])
}

model Complaint {
  id           String          @id @default(uuid())
  title        String
  description  String
  photoUrl     String?
  latitude     Float?
  longitude    Float?
  status       ComplaintStatus @default(OPEN)
  citizenId    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  departmentId String?
  history      ActionLog[]
  citizen      User            @relation(fields: [citizenId], references: [id])
  department   Department?     @relation(fields: [departmentId], references: [id])
}

model MissingDocument {
  id               String                @id @default(uuid())
  title            String
  description      String
  photoUrl         String?
  lastSeenLocation String?
  latitude         Float?
  longitude        Float?
  status           MissingDocumentStatus @default(MISSING)
  isVerified       Boolean               @default(false)
  reportedById     String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  history          ActionLog[]
  reportedBy       User                  @relation(fields: [reportedById], references: [id])
}

model ActionLog {
  id                      String                 @id @default(uuid())
  action                  String
  description             String?
  actorId                 String
  administrativeRequestId String?
  complaintId             String?
  createdAt               DateTime               @default(now())
  missingDocumentId       String?
  actor                   User                   @relation(fields: [actorId], references: [id])
  administrativeRequest   AdministrativeRequest? @relation(fields: [administrativeRequestId], references: [id])
  complaint               Complaint?             @relation(fields: [complaintId], references: [id])
  missingDocument         MissingDocument?       @relation(fields: [missingDocumentId], references: [id])
}

model InvestmentProject {
  id          String        @id @default(uuid())
  reference   String        @unique
  name        String
  description String?
  company     String
  budget      Float
  spentAmount Float         @default(0)
  progress    Int           @default(0)
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum Role {
  ADMIN
  AGENT
  CITIZEN
}

enum RequestStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  PROCESSED
  VALIDATED
  AWAITING_PAYMENT
  COMPLETED
  REJECTED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MissingDocumentStatus {
  MISSING
  FOUND
  RETURNED
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SUSPENDED
}
